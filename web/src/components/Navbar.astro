---
import IconStar from './icons/IconStar.astro';
---

<nav class="fixed top-0 w-full z-50 border-b border-border/40 bg-background/80 backdrop-blur-md">
  <div class="container mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <img src="/justred-logo.svg" alt="JustRed Logo" class="w-8 h-8" />
      <span class="font-heading font-bold text-xl">JustRed</span>
    </a>
    
    <div class="hidden md:flex items-center gap-8 text-sm font-medium text-muted-foreground">
      <a href="/#features" class="hover:text-foreground transition-colors">Features</a>
      <a href="/blog" class="hover:text-foreground transition-colors">Blog</a>
      <a href="https://github.com/justred-tech/justred/" target="_blank" class="hover:text-foreground transition-colors">GitHub</a>
    </div>

    <div class="flex items-center gap-4">
      <a href="https://github.com/justred-tech/justred/" target="_blank" class="hidden sm:flex items-center gap-2 text-sm font-medium border border-border rounded-md px-3 py-1.5 hover:bg-muted transition-colors">
        <IconStar class="text-yellow-400" />
        <span>Star us</span>
      </a>
      <a href="https://github.com/justred-tech/justred/" target="_blank" class="bg-primary hover:bg-primary/90 text-primary-foreground text-sm font-medium px-4 py-2 rounded-md transition-colors">
        Get Extension
      </a>
    </div>
  </div>
</nav>

---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<Layout title={title} description={description} image={heroImage}>
	<Navbar />
	
	<main class="pt-32 pb-20 px-4">
		<article class="container mx-auto max-w-3xl prose prose-invert prose-lg prose-headings:font-heading prose-a:text-primary hover:prose-a:text-primary/80">
			<div class="mb-10 text-center">
				{heroImage && <img width={1020} height={510} src={heroImage} alt="" class="rounded-xl shadow-2xl mb-8 w-full object-cover aspect-video" />}
				<div class="flex items-center justify-center gap-2 text-muted-foreground mb-4">
					<time datetime={pubDate.toISOString()}>
						{pubDate.toLocaleDateString('en-us', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})}
					</time>
					{updatedDate && (
						<div class="italic">
							(Updated on <time datetime={updatedDate.toISOString()}>
								{updatedDate.toLocaleDateString('en-us', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</time>)
						</div>
					)}
				</div>
				<h1 class="text-4xl md:text-5xl font-bold mb-4">{title}</h1>
				<p class="text-xl text-muted-foreground">{description}</p>
				<hr class="border-border/40 my-8" />
			</div>
			<slot />
		</article>
	</main>

	<Footer />
</Layout>

---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog - JustRed" description="Latest news and updates from the JustRed team.">
	<Navbar />
	
	<main class="pt-32 pb-20 px-4">
		<section class="container mx-auto max-w-5xl">
			<div class="text-center mb-16">
				<h1 class="text-4xl md:text-6xl font-heading font-bold mb-6">Blog</h1>
				<p class="text-xl text-muted-foreground max-w-2xl mx-auto">
					Thoughts on privacy, open source, and building JustRed.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{posts.map((post) => (
					<a href={`/blog/${post.slug}/`} class="group block">
						<article class="bg-muted/20 border border-border rounded-xl overflow-hidden hover:bg-muted/40 transition-colors h-full flex flex-col">
							{post.data.heroImage && (
								<div class="aspect-video overflow-hidden">
									<img 
										src={post.data.heroImage} 
										alt="" 
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
									/>
								</div>
							)}
							<div class="p-6 flex-1 flex flex-col">
								<div class="text-sm text-primary font-medium mb-2">
									<time datetime={post.data.pubDate.toISOString()}>
										{post.data.pubDate.toLocaleDateString('en-us', {
											year: 'numeric',
											month: 'short',
											day: 'numeric',
										})}
									</time>
								</div>
								<h2 class="text-xl font-bold mb-3 group-hover:text-primary transition-colors">
									{post.data.title}
								</h2>
								<p class="text-muted-foreground line-clamp-3 mb-4 flex-1">
									{post.data.description}
								</p>
								<div class="text-sm font-medium flex items-center gap-1 text-primary">
									Read more
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
								</div>
							</div>
						</article>
					</a>
				))}
			</div>
		</section>
	</main>

	<Footer />
</Layout>

{
  "manifest_version": 3,
  "name": "Just Red POC Extension",
  "version": "1.0",
  "description": "Extension that fetches a random number from the backend on google.com",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.google.com/*"],
      "js": ["config.js", "content.js"]
    }
  ]
}
